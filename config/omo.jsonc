// OMO configuration
// Telemetry opt-out: env OMO_SEND_ANONYMOUS_TELEMETRY=0 (config key broken in 4.19.4 and 5.0.0-beta.56)
{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "browser_automation_engine": {
      "provider": "playwright-cli"
    },
    "disabled_mcps": [
      "websearch"
    ],
    // Live-listener parent-wake dispatch is a silent no-op under TUI-in-tmux/SSH
    // (opencode 1.18.30 + OmO 5.0.0-beta.62): dispatched wake never creates a
    // session prompt, retries coalesce-drop, "Stopped retrying parent wake after
    // repeated no-output dispatch". Force the in-process client route instead.
    "experimental": {
      "disable_live_parent_wake_routing": true
    },
    "agents": {
      "sisyphus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "oracle": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "hephaestus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "librarian": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "explore": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "multimodal-looker": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "prometheus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "metis": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "momus": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "atlas": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "sisyphus-junior": {
        "model": "zai-coding-plan/glm-5.3-flash"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "ultrabrain": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "deep": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "artistry": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "quick": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "unspecified-low": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "unspecified-high": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "writing": {
        "model": "zai-coding-plan/glm-5.3"
      }
    }
  },
  "profiles": {
    // Activated with OMO_PROFILE=local (env) — routes ALL agents/categories to the
    // local gufo engine (llama-server-linux). Default (no profile) = cloud routing above.
    "local": {
      "[opencode]": {
        "agents": {
          "sisyphus": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "oracle": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "hephaestus": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "prometheus": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "metis": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "librarian": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "explore": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "multimodal-looker": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "momus": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "atlas": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "sisyphus-junior": { "model": "llama-server-linux/Qwen3.8 Flash Next" }
        },
        "categories": {
          "visual-engineering": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "ultrabrain": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "deep": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "artistry": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "quick": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "unspecified-low": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "unspecified-high": { "model": "llama-server-linux/Qwen3.8 Flash Next" },
          "writing": { "model": "llama-server-linux/Qwen3.8 Flash Next" }
        }
      }
    }
  }
}
