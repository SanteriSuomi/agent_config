// OMO configuration
// Telemetry opt-out: env OMO_SEND_ANONYMOUS_TELEMETRY=0 (config key broken in 4.19.4 and 5.0.0-beta.56)
{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "agents": {
      "sisyphus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "oracle": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "hephaestus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "librarian": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "explore": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "multimodal-looker": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "prometheus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "metis": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "momus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "atlas": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "sisyphus-junior": {
        "model": "zai-coding-plan/glm-5.3-flash"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "ultrabrain": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "deep": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "artistry": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "quick": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "unspecified-low": {
        "model": "zai-coding-plan/glm-5.3-flash"
      },
      "unspecified-high": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "writing": {
        "model": "zai-coding-plan/glm-5.3"
      }
    }
  }
}
